---
const base = import.meta.env.BASE_URL;

interface Props {
  active: 'main' | 'posts' | 'tools';
}

const { active } = Astro.props;

const tabs = [
  { id: 'main', label: 'Main', href: base },
  { id: 'posts', label: 'Posts', href: `${base}posts/` },
  { id: 'tools', label: 'Tools', href: `${base}tools/` },
];
---

<nav class="pixel-line mb-2" aria-label="Sections">
  <ul class="flex gap-1 list-none p-0 m-0">
    {tabs.map(tab => (
      <li>
        <a
          href={tab.href}
          aria-current={active === tab.id ? 'page' : undefined}
          class:list={[
            'label block px-3 py-2 no-underline hover:no-underline',
            active === tab.id
              ? 'bg-accent text-bg'
              : 'text-text opacity-60 hover:opacity-100 hover:text-link',
          ]}
        >{tab.label}</a>
      </li>
    ))}
  </ul>
</nav>
