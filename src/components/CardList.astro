---
import DitherThumb from './DitherThumb.astro';
import type { ImageMetadata } from 'astro';

interface CardItem {
  url: string;
  title: string;
  type?: 'post' | 'tool';
  stage?: 'scribble' | 'draft' | 'tale';
  tags?: string[];
  description?: string;
  date?: Date;
  image?: { src: ImageMetadata; dither: 'ui' | 'image' };
}

interface Props {
  items: CardItem[];
  showImages?: boolean;
}

const { items, showImages = true } = Astro.props;
---

<div class="flex flex-col gap-2 mt-3">
  {items.map(item => (
    <div class="flex flex-row items-stretch overflow-hidden">
      <div class="flex flex-col justify-center py-1 min-w-0 flex-1">
        <h2 class="font-pixel text-pixel-md font-normal m-0"><a href={item.url} class="text-heading no-underline hover:text-link hover:underline decoration-accent decoration-2 underline-offset-4">{item.title}</a></h2>
        <div class="flex items-baseline gap-2 flex-wrap mt-1">
          {item.type && <span class="label opacity-50">{item.type}</span>}
          {item.stage && <a href="/stages/" class="label text-accent no-underline hover:underline">{item.stage}</a>}
          {item.tags?.map(tag => <span class="label opacity-50">#{tag}</span>)}
          {item.date && (
            <time datetime={item.date.toISOString().split('T')[0]} class="label opacity-50">
              {item.date.toISOString().split('T')[0]}
            </time>
          )}
        </div>
        {item.description && (
          <p class="font-pixel text-pixel m-0 mt-1 text-text leading-normal opacity-80">{item.description}</p>
        )}
      </div>
      {showImages && item.image && (
        <DitherThumb
          href={item.url}
          image={item.image.src}
          alt={`Screenshot of ${item.title}`}
          dither={item.image.dither}
          widths={[200, 360]}
          sizes="100px"
          class="w-[72px] h-[80px] min-w-[72px] max-sm:w-[56px] max-sm:h-[64px] max-sm:min-w-[56px] ml-3"
        />
      )}
    </div>
  ))}
</div>
