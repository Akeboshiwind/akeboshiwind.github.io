---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  image: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  class?: string;
}

const { href, image, alt, widths, sizes, class: className = '' } = Astro.props;
---

<a href={href} class:list={['block border border-border', className]}>
  <Image src={image} alt={alt} class="w-full h-full object-cover object-center" loading="lazy" widths={widths} sizes={sizes} />
</a>
