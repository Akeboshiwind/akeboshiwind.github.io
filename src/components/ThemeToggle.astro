---
// Single-button tri-state toggle: cycles auto → light → dark → auto.
// Icon reflects the current preference. Pass `class` to position it.
import Icon from './pixel/Icon.astro';
const { class: className = '' } = Astro.props;
---
<button
  type="button"
  class:list={['theme-toggle inline-flex items-center justify-center w-9 h-9 border border-border text-text hover:text-bg hover:bg-accent hover:border-accent cursor-pointer', className]}
  aria-label="Theme: auto"
  title="Theme: auto"
>
  <span class="hidden pref-auto:inline-flex"><Icon name="monitor" class="w-6 h-6" /></span>
  <span class="hidden pref-light:inline-flex"><Icon name="sun" class="w-6 h-6" /></span>
  <span class="hidden pref-dark:inline-flex"><Icon name="moon" class="w-6 h-6" /></span>
</button>

<script>
  const order = ['auto', 'light', 'dark'] as const;
  type Pref = typeof order[number];
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
  const sync = () => {
    const pref = (document.documentElement.dataset.themePref as Pref) ?? 'auto';
    const label = `Theme: ${pref}`;
    btn.setAttribute('aria-label', label);
    btn.setAttribute('title', label);
  };
  btn.addEventListener('click', () => {
    const current = (document.documentElement.dataset.themePref as Pref) ?? 'auto';
    const next = order[(order.indexOf(current) + 1) % order.length];
    (window as any).__setTheme?.(next);
    sync();
  });
  sync();
</script>

