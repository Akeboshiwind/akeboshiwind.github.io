---
import { ACCENTS, PAGE_BACKGROUND } from '../lib/accents.js';
import { version } from '../lib/favicon-version.json';

// Safari keeps favicons in a separate cache that a reload doesn't refresh, so every URL carries the version
// `npm run favicons` derives from the icons it draws: new icons get new URLs, and browsers fetch them afresh.
const url = (file: string) => `/${file}?v=${version}`;
---

<link rel="apple-touch-icon" sizes="180x180" href={url('apple-touch-icon.png')} />
<link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
<link rel="icon" type="image/png" sizes="32x32" href={url('favicon-32x32.png')} />
<link rel="icon" type="image/png" sizes="16x16" href={url('favicon-16x16.png')} />
<link rel="shortcut icon" href={url('favicon.ico')} />
<link rel="manifest" href={url('site.webmanifest')} />
<link rel="mask-icon" href={url('safari-pinned-tab.svg')} color={ACCENTS[0].light.accent} />
<meta name="msapplication-TileColor" content={PAGE_BACKGROUND} />
<meta name="msapplication-config" content={url('browserconfig.xml')} />
