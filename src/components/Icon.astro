---
// The SVG strings are only used during static rendering, so they never ship to the client bundle.
const load = (modules: Record<string, string>) =>
  Object.fromEntries(Object.entries(modules).map(([path, svg]) => [
    path.slice(path.lastIndexOf('/') + 1, -'.svg'.length),
    svg,
  ]));

const LUCIDE = load(import.meta.glob<string>(
  '../../node_modules/lucide-static/icons/*.svg',
  { query: '?raw', import: 'default', eager: true }
));

interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'w-5 h-5' } = Astro.props;
const svg = LUCIDE[name];
if (!svg) throw new Error(`[Icon] unknown icon "${name}": not a lucide-static name`);
---

<span class={`inline-flex items-center justify-center ${className}`} set:html={svg} />
