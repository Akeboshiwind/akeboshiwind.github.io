---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CardList from '../../components/CardList.astro';
import Tabs from '../../components/Tabs.astro';

const base = import.meta.env.BASE_URL;

const notes = await getCollection('notes');

const items = notes
  .map(note => ({
    url: `${base}${note.slug}/`,
    title: note.data.title,
    stage: note.data.stage,
    date: note.data.updated ?? note.data.published,
  }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const years = [...new Set(items.map(i => i.date.getFullYear()))].sort((a, b) => b - a);
const grouped = years.map(year => ({
  year,
  items: items.filter(i => i.date.getFullYear() === year),
}));
---

<Layout title="Posts" description="Everything written on this site, newest first.">
  <Tabs active="posts" />

  <h1 class="text-2xl font-bold text-heading mt-4 mb-2">Posts</h1>
  <p class="text-sm opacity-70 mt-0 mb-4">
    {items.length} {items.length === 1 ? 'post' : 'posts'}, newest first. Dates are last updated.
  </p>

  {grouped.map(group => (
    <section class="mb-6">
      <h2 class="text-sm font-semibold text-heading uppercase tracking-wide opacity-70 mt-0 mb-0 pb-1 border-b border-border">
        {group.year}
      </h2>
      <CardList items={group.items} showImages={false} />
    </section>
  ))}
</Layout>
