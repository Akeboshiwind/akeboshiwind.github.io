---
// Full-page SPA — no Astro layout
import ThemeInit from '../../components/ThemeInit.astro';
import Favicons from '../../components/Favicons.astro';
import DitherScript from '../../components/DitherScript.astro';
---
<html lang="en" class="font-sans text-text bg-bg">
<head>
  <ThemeInit />
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bitemporal Visualizer</title>
  <Favicons />
  <link rel="preload" href="/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <div id="app"></div>
  <script>
    import './_app/app.cljs';
  </script>
  <DitherScript />
</body>
</html>
