---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { historyFromPath } from '../lib/history.js';

export async function getStaticPaths() {
  const notes = await getCollection('notes');

  return notes.map(note => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await note.render();
const historyUrl = historyFromPath(`src/content/notes/${note.id}`);
---

<Layout
  title={`A ${note.data.stage}: ${note.data.title}`}
  description={note.data.title}
  type="article"
  publishedTime={note.data.published}
>
  <article class="prose prose-sm font-sans max-w-none leading-relaxed
    prose-a:no-underline prose-a:hover:underline
    prose-code:font-mono prose-code:bg-code-bg prose-code:text-code-text prose-code:px-1 prose-code:rounded-none prose-code:font-normal prose-code:before:content-none prose-code:after:content-none
    prose-pre:font-mono">
    <h1>
      <a href="/stages/" class="label block mb-2 font-normal text-accent no-underline hover:underline">A {note.data.stage}</a>{note.data.title}
    </h1>

    <p class="label">
      <time datetime={note.data.published.toISOString().split('T')[0]}>
        {note.data.published.toISOString().split('T')[0]}
      </time>
      {note.data.updated && (
        <span class="opacity-60">
          {' · updated '}
          <time datetime={note.data.updated.toISOString().split('T')[0]}>
            {note.data.updated.toISOString().split('T')[0]}
          </time>
        </span>
      )}
      <span class="opacity-60">
        {' · '}
        <a href={historyUrl} target="_blank" rel="noopener">history</a>
      </span>
    </p>

    <Content />

    {note.data.tags && note.data.tags.length > 0 && (
      <p>
        Tags: {note.data.tags.map((tag, i) => (
          <span>
            {i > 0 && ', '}
            #{tag}
          </span>
        ))}
      </p>
    )}
  </article>
  <dialog class="prose-lightbox" aria-label="Full-size image"><img alt="" /></dialog>
</Layout>

<script>
  import { wireImageLightbox } from '../lib/image-lightbox.js';

  wireImageLightbox(document.querySelector('article')!, document.querySelector<HTMLDialogElement>('.prose-lightbox')!);
</script>
