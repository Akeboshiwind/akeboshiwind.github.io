---
import Layout from '../layouts/Layout.astro';
import CardList from '../components/CardList.astro';
import Tabs from '../components/Tabs.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const notes = await getCollection('notes');
const works = await getCollection('works');

const screenshots = import.meta.glob<{ default: import('astro').ImageMetadata }>('../assets/works/*.png', { eager: true });

function workUrl(work: { id: string; data: { url?: string } }) {
  return work.data.url || `${base}${work.id.replace('.json', '')}/`;
}

function thumbnail(work: { id: string; data: { dither: 'ui' | 'image' } }) {
  const src = screenshots[`../assets/works/${work.id.replace('.json', '')}.png`]?.default;
  return src && { src, dither: work.data.dither };
}

const allItems = [
  ...notes.map(note => ({
    url: `${base}${note.slug}/`,
    title: note.data.title,
    type: 'post' as const,
    stage: note.data.stage,
    tags: note.data.tags,
    date: note.data.updated ?? note.data.published,
  })),
  ...works.map(work => ({
    url: workUrl(work),
    title: work.data.title,
    type: 'tool' as const,
    stage: work.data.stage,
    tags: work.data.tags,
    description: work.data.description,
    date: work.data.updated ?? work.data.published,
    image: thumbnail(work),
  })),
];

const items = allItems.sort((a, b) => b.date.getTime() - a.date.getTime());
---

<Layout>
  <Tabs active="main" />

  <CardList items={items} />
</Layout>
