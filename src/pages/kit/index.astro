---
import PixelAppLayout from '../../layouts/PixelAppLayout.astro';
import SectionLabel from '../../components/pixel/SectionLabel.astro';
import Icon from '../../components/pixel/Icon.astro';
import FileDrop from '../../components/pixel/FileDrop.astro';
import Sheet from '../../components/pixel/Sheet.astro';
import Menu from '../../components/pixel/Menu.astro';

const themes = ['light', 'dark'];
const swatches = ['bg', 'code-bg', 'border', 'text', 'heading', 'link', 'accent', 'danger', 'ok', 'warn'];
---
<PixelAppLayout title="Pixel Kit" wide>
  <main class="w-full max-w-[1100px] mx-auto flex flex-col gap-6">
    <header class="flex flex-col gap-2">
      <h1 class="page-title">Pixel Kit</h1>
      <p class="page-sub">
        The classes and components the pixel-styled tools and posts are drawn from, in both themes.
        Classes live in <code>src/styles/theme.css</code>, components in <code>src/components/pixel/</code>.
      </p>
    </header>

    <div class="grid gap-4 md:grid-cols-2">
      {themes.map((theme) => (
        <section data-theme={theme} class="pixel-panel bg-bg text-text p-4 flex flex-col gap-2">
          <p class="label opacity-60">{theme}</p>

          <SectionLabel class="mt-4 mb-2">Type</SectionLabel>
          <p class="page-title">.page-title</p>
          <p class="page-sub">.page-sub</p>
          <p class="label">.label</p>

          <SectionLabel class="mt-4 mb-2">Section label</SectionLabel>
          <p class="label opacity-60">&lt;SectionLabel&gt; · .section-label .section-fade</p>

          <SectionLabel class="mt-4 mb-2">Buttons</SectionLabel>
          <div class="flex flex-wrap gap-2">
            <button class="pixel-button">Default</button>
            <button class="pixel-button" data-variant="primary">Primary</button>
            <button class="pixel-button" data-variant="danger">Danger</button>
            <button class="pixel-button" disabled>Disabled</button>
          </div>
          <p class="label opacity-60">.pixel-button · data-variant="primary" | "danger"</p>

          <SectionLabel class="mt-4 mb-2">Tones</SectionLabel>
          <div class="flex flex-wrap items-center gap-2">
            <button class="pixel-button" data-variant="primary">Save</button>
            <button class="pixel-button" data-variant="danger">Delete list</button>
            <button class="pixel-button" data-variant="warn">Retry</button>
            <button class="pixel-button" data-variant="ok">Mark done</button>
          </div>
          <div class="flex flex-wrap gap-1">
            <span class="pixel-chip" data-variant="danger">Poor</span>
            <span class="pixel-chip" data-variant="warn">OK</span>
            <span class="pixel-chip" data-variant="ok">Great</span>
          </div>
          <div class="pixel-alert">
            <p class="label">Couldn't import</p>
            <p class="m-0 text-text">The file isn't valid JSON.</p>
          </div>
          <div class="pixel-alert" data-variant="warn">
            <p class="label">Configuration warnings</p>
            <p class="m-0 text-text">Two accounts have no type set.</p>
          </div>
          <div class="pixel-alert" data-variant="ok">
            <p class="label">Imported</p>
            <p class="m-0 text-text">42 transactions for September.</p>
          </div>
          <p class="label m-0 flex flex-wrap gap-4">
            <span class="pixel-alert-text">API error 401</span>
            <span class="pixel-alert-text" data-variant="warn">No reduction</span>
            <span class="pixel-alert-text" data-variant="ok">62% smaller</span>
          </p>
          <p class="label flex items-center gap-4">
            <span class="flex items-center gap-2"><span class="pixel-mark w-3 h-3"></span> failed</span>
            <span class="flex items-center gap-2"><span class="pixel-mark w-3 h-3" data-variant="warn"></span> retrying</span>
            <span class="flex items-center gap-2"><span class="pixel-mark w-3 h-3" data-variant="ok"></span> done</span>
          </p>
          <p class="label opacity-60">Never colour alone: danger is hatched, warn is dotted, ok is solid · data-variant="danger" | "warn" | "ok" on .pixel-button, .pixel-chip, .pixel-alert, .pixel-alert-text, .pixel-mark (danger is the default) · an icon-only action's glyph is its shape</p>

          <SectionLabel class="mt-4 mb-2">Icon buttons</SectionLabel>
          <div class="flex flex-wrap gap-1">
            <button class="pixel-icon-button" aria-label="Edit"><Icon name="pencil" class="w-4 h-4" /></button>
            <button class="pixel-icon-button" data-variant="ok" aria-label="Mark done"><Icon name="check" class="w-4 h-4" /></button>
            <button class="pixel-icon-button" data-variant="danger" aria-label="Delete"><Icon name="trash" class="w-4 h-4" /></button>
            <button class="pixel-icon-button" aria-label="More"><Icon name="more-horizontal" class="w-5 h-5" /></button>
            <button class="pixel-icon-button" aria-label="Disabled" disabled><Icon name="arrow-up" class="w-4 h-4" /></button>
          </div>
          <p class="label opacity-60">.pixel-icon-button · no border, at least 32px square · accent on hover, data-variant="danger" | "ok" swaps the hover colour</p>

          <SectionLabel class="mt-4 mb-2">Chips</SectionLabel>
          <div class="flex flex-wrap gap-1">
            <span class="pixel-chip">Static</span>
            <button class="pixel-chip" aria-pressed="false">Off</button>
            <button class="pixel-chip" aria-pressed="true">Pressed</button>
            <button class="pixel-chip" aria-expanded="true">Expanded</button>
            <button class="pixel-chip" disabled>Disabled</button>
          </div>
          <p class="label opacity-60">.pixel-chip · on when aria-pressed or aria-expanded is "true"</p>

          <SectionLabel class="mt-4 mb-2">Fields</SectionLabel>
          <div class="flex flex-wrap gap-2">
            <input class="pixel-field" placeholder="Text" />
            <select class="pixel-field font-pixel text-pixel-md"><option>£ GBP</option><option>€ EUR</option></select>
          </div>
          <textarea class="pixel-field w-full font-pixel text-pixel" rows="2" placeholder="Textarea"></textarea>
          <p class="label opacity-60">.pixel-field</p>

          <SectionLabel class="mt-4 mb-2">Checkbox</SectionLabel>
          <div class="flex gap-4">
            <label class="flex items-center gap-2"><input type="checkbox" class="pixel-check" /> Off</label>
            <label class="flex items-center gap-2"><input type="checkbox" class="pixel-check" checked /> On</label>
            <label class="flex items-center gap-2"><input type="checkbox" class="pixel-check" data-variant="ok" checked /> Done</label>
          </div>
          <p class="label opacity-60">.pixel-check · data-variant="ok" fills --ok when checked</p>

          <SectionLabel class="mt-4 mb-2">Radio</SectionLabel>
          <div class="flex gap-4">
            <label class="flex items-center gap-2"><input type="radio" name={`kit-radio-${theme}`} class="pixel-radio" /> Off</label>
            <label class="flex items-center gap-2"><input type="radio" name={`kit-radio-${theme}`} class="pixel-radio" checked /> On</label>
          </div>
          <p class="label opacity-60">.pixel-radio · input[type=radio], a filled square rather than a tick</p>

          <SectionLabel class="mt-4 mb-2">Range</SectionLabel>
          <input type="range" class="pixel-range" min="0" max="100" value="40" aria-label="Range" />
          <input type="range" class="pixel-range" min="0" max="100" value="70" aria-label="Disabled range" disabled />
          <p class="label opacity-60">.pixel-range · input[type=range]</p>

          <SectionLabel class="mt-4 mb-2">Progress</SectionLabel>
          <progress class="pixel-progress" value="40" max="100" aria-label="Determinate progress"></progress>
          <progress class="pixel-progress" aria-label="Indeterminate progress"></progress>
          <p class="label opacity-60">.pixel-progress · &lt;progress&gt;, a stepping block while it has no value</p>

          <SectionLabel class="mt-4 mb-2">File</SectionLabel>
          <FileDrop accept="image/*">Drop a file or click to choose</FileDrop>
          <label class="pixel-file" data-dragover>Drag-over</label>
          <p class="label opacity-60">&lt;FileDrop&gt; · .pixel-file · accent on hover, focus and data-dragover</p>

          <SectionLabel class="mt-4 mb-2">Panel</SectionLabel>
          <div class="pixel-panel bg-code-bg p-3">A bordered box for a toolbar, a badge or a sidebar.</div>
          <p class="label opacity-60">.pixel-panel</p>

          <SectionLabel class="mt-4 mb-2">Table</SectionLabel>
          <div class="overflow-x-auto">
            <table class="pixel-table">
              <thead><tr><th>Category</th><th class="text-right">His</th><th class="text-right">Her</th><th class="text-right">Total</th></tr></thead>
              <tbody>
                <tr><td>Groceries</td><td class="text-right pixel-num">£412.33</td><td class="text-right pixel-num">£389.15</td><td class="text-right pixel-num">£801.48</td></tr>
                <tr><td>Eating Out</td><td class="text-right pixel-num">£134.46</td><td class="text-right pixel-num">£220.25</td><td class="text-right pixel-num">£354.71</td></tr>
              </tbody>
            </table>
          </div>
          <p class="pixel-num">£1,203.19</p>
          <p class="label opacity-60">.pixel-table · .pixel-num, 11px inside a table on phones</p>

          <SectionLabel class="mt-4 mb-2">Sheet</SectionLabel>
          <div class="pixel-panel relative h-56 overflow-hidden">
            <p class="p-3">The page behind the scrim.</p>
            <Sheet title="Choose a meal" class="absolute">
              <ul class="flex flex-col gap-1"><li>Pasta</li><li>Rajma</li><li>Sambar</li></ul>
            </Sheet>
          </div>
          <p class="label opacity-60">&lt;Sheet&gt; · .pixel-scrim .pixel-sheet · from the bottom edge on phones, centred from sm</p>

          <SectionLabel class="mt-4 mb-2">Bottom bar</SectionLabel>
          <div class="pixel-panel relative h-32 overflow-hidden">
            <p class="p-3">The page above the bar.</p>
            <div class="pixel-bar absolute flex items-center gap-2">
              <span class="flex-1 pixel-num">02:15</span>
              <button class="pixel-button">Pause</button>
              <button class="pixel-button" data-variant="primary">Save</button>
            </div>
          </div>
          <p class="label opacity-60">.pixel-bar · fixed to the bottom edge, content in the 720px column, clear of the home indicator · data-position="sticky" for the end of a form</p>

          <SectionLabel class="mt-4 mb-2">Menu</SectionLabel>
          <div class="flex justify-end items-start h-44">
            <Menu label="Options" icon="more-vertical" items={['Rename', 'Export', 'Delete']} open />
          </div>
          <p class="label opacity-60">&lt;Menu&gt; · .pixel-menu .pixel-menu-trigger .pixel-menu-list .pixel-menu-item · arrow keys move, Escape, Tab, a choice or a press outside close · side="top" opens upward</p>

          <SectionLabel class="mt-4 mb-2">Icons</SectionLabel>
          <div class="flex gap-3 text-heading">
            <Icon name="lock" />
            <Icon name="heart" />
            <Icon name="brush" />
            <Icon name="grid-3x3" class="w-8 h-8 text-accent" />
          </div>
          <p class="label opacity-60">&lt;Icon&gt; · .pixel-icon</p>

          <SectionLabel class="mt-4 mb-2">Rules</SectionLabel>
          <div class="pixel-line h-0.5"></div>
          <p class="label opacity-60">.pixel-line</p>
          <hr class="my-4" />
          <p class="label opacity-60">&lt;hr&gt;</p>

          <SectionLabel class="mt-4 mb-2">Colours</SectionLabel>
          <div class="grid grid-cols-4 gap-2">
            {swatches.map((name) => (
              <div class="flex flex-col gap-1">
                <span class="pixel-panel h-8" style={`background: var(--${name})`}></span>
                <span class="label opacity-60">--{name}</span>
              </div>
            ))}
          </div>
          <p class="label flex gap-4"><span class="pixel-alert-text">.pixel-alert-text</span></p>
        </section>
      ))}
    </div>
  </main>
</PixelAppLayout>
