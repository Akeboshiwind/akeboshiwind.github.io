---
import Favicons from '../components/Favicons.astro';
import { PAGE_BACKGROUND } from '../lib/accents.js';
import '../styles/global.css';
import Header from '../components/Header.astro';
import ThemeInit from '../components/ThemeInit.astro';
import DitherScript from '../components/DitherScript.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title,
  description,
  type = 'website',
  publishedTime,
} = Astro.props;

const siteTitle = 'By the Rocks';
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en" class="font-sans text-base leading-relaxed text-text bg-bg">
<head>
  <ThemeInit />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="X-Clacks-Overhead" content="GNU Terry Pratchett" />

  <Favicons />
  <meta name="theme-color" content={PAGE_BACKGROUND} />
  <link rel="preload" href="/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin />

  <!-- SEO -->
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={siteTitle} />
  {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
</head>
<body class="mx-auto px-5 max-w-[720px]">
  <Header />
  <main>
    <slot />
  </main>
  <footer class="mt-16">
    <span data-dither="ripples" class="h-12" aria-hidden="true"></span>
    <p class="label text-center text-text opacity-70 my-4">&copy; {new Date().getFullYear()} By the Rocks</p>
  </footer>
  <DitherScript />
</body>
</html>
